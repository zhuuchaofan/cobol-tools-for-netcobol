          "match": "(?<![\\p{L}\\p{N}_\\-])(?i:FOREGROUND\\-COLOR|BACKGROUND\\-COLOR|COMPUTATIONAL\\-1|COMPUTATIONAL\\-2|COMPUTATIONAL\\-3|COMPUTATIONAL\\-4|COMPUTATIONAL\\-5|PROGRAM\\-POINTER|PACKED\\-DECIMAL|FLOAT\\-EXTENDED|COMPUTATIONAL|REVERSE\\-VIDEO|SYNCHRONIZED|FLOAT\\-SHORT|DESCENDING|CHARACTERS|FLOAT\\-LONG|REDEFINES|DEPENDING|ASCENDING|CHARACTER|JUSTIFIED|DISPLAY\\-1|REFERENCE|AUTO\\-SKIP|HIGHLIGHT|UNDERLINE|TRAILING|SEPARATE|EXTERNAL|CONSTANT|CONTAINS|STANDARD|CODE\\-SET|NATIONAL|LOWLIGHT|REQUIRED|PICTURE|RENAMES|INDEXED|LEADING|TYPEDEF|RECORDS|OMITTED|FOOTING|POINTER|VALUES|OCCURS|GLOBAL|FILLER|RECORD|LINAGE|BOTTOM|BINARY|COMP\\-1|COMP\\-2|COMP\\-3|COMP\\-4|COMP\\-5|SECURE|PROMPT|VALUE|USAGE|BLANK|BASED|BLOCK|LABEL|INDEX|BLINK|ERASE|SIGN|SYNC|JUST|TYPE|COMP|AUTO|BELL|FULL|PIC|KEY|TOP|COL|EOL|EOS)(?![\\p{L}\\p{N}_\\-])",
          "name": "storage.type.netcobol"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_\\-])(?i:ALPHANUMERIC\\-EDITED|ALPHABETIC\\-LOWER|ALPHABETIC\\-UPPER|SOURCE\\-COMPUTER|OBJECT\\-COMPUTER|WORKING\\-STORAGE|NATIONAL\\-EDITED|IDENTIFICATION|NUMERIC\\-EDITED|DECIMAL\\-POINT|SEGMENT\\-LIMIT|DATE\\-COMPILED|CONFIGURATION|SPECIAL\\-NAMES|LOCAL\\-STORAGE|COMMUNICATION|CORRESPONDING|ORGANIZATION|INSTALLATION|DATE\\-WRITTEN|INPUT\\-OUTPUT|FILE\\-CONTROL|DECLARATIVES|ALPHANUMERIC|ENVIRONMENT|I\\-O\\-CONTROL|END\\-OF\\-PAGE|SUB\\-QUEUE\\-1|SUB\\-QUEUE\\-2|SUB\\-QUEUE\\-3|DESTINATION|CLOCK\\-UNITS|SEQUENTIAL|DUPLICATES|STANDARD\\-1|STANDARD\\-2|PROGRAM\\-ID|REPOSITORY|CONVERTING|PROCEDURES|REFERENCES|SORT\\-MERGE|ALPHABETIC|ALTERNATE|COLLATING|RECURSIVE|DEBUGGING|PROCEDURE|METHOD\\-ID|RETURNING|REMAINDER|EXCEPTION|ADVANCING|REPLACING|DELIMITED|DELIMITER|REPORTING|OPTIONAL|RELATIVE|MULTIPLE|CURRENCY|ALPHABET|SYMBOLIC|SEQUENCE|PRINTING|DIVISION|SECURITY|CLASS\\-ID|INHERITS|OVERFLOW|REVERSED|TALLYING|SENTENCE|POSITION|CONTROLS|INDICATE|TERMINAL|POSITIVE|NEGATIVE|DYNAMIC|SHARING|RESERVE|PADDING|MODULES|INITIAL|SECTION|LINKAGE|PROGRAM|FACTORY|ROUNDED|INVALID|CONTENT|REMOVAL|VARYING|THROUGH|PROCEED|HEADING|CONTROL|REPORTS|MESSAGE|SEGMENT|GREATER|NUMERIC|SELECT|ASSIGN|ACCESS|RANDOM|STATUS|CURSOR|NATIVE|MEMORY|COMMON|AUTHOR|REPORT|SCREEN|OBJECT|METHOD|GIVING|OUTPUT|EXTEND|REWIND|BEFORE|NUMBER|LIMITS|DETAIL|SOURCE|COLUMN|AREAS|RERUN|COMMA|CLASS|WORDS|USING|ERROR|INPUT|FIRST|COUNT|AFTER|LINES|ORDER|OTHER|UNTIL|TIMES|RESET|TALLY|LIMIT|FINAL|GROUP|TABLE|QUEUE|COBOL|ENTER|EVERY|EQUAL|LINE|MODE|LOCK|AREA|SAME|SIZE|DATA|FILE|FROM|INTO|UPON|LAST|CORR|PAGE|UNIT|REEL|THEN|ALSO|THRU|TEST|WITH|NEXT|DOWN|PLUS|TEXT|TAPE|CODE|LESS|THAN|CRT|END|OFF|EOP|ALL|I\\-O|FOR|ANY|RUN|SUM|EGI|EMI|ESI|AND|NOT|ARE|ID|FD|SD|RD|CD|TO|BY|ON|AT|NO|OF|IN|AS|UP|PF|PH|RF|RH|CF|CH|DE|OR|IS)(?![\\p{L}\\p{N}_\\-])",
          "name": "keyword.other.netcobol"
        }
      ]
    },
    "numbers": {
      "match": "(?<![\\p{L}\\p{N}_\\-])(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?![\\p{L}\\p{N}_\\-])",
      "name": "constant.numeric.netcobol"
    },
    "identifier": {
      "match": "(?<![\\p{L}\\p{N}_\\-])[\\p{L}\\p{N}][\\p{L}\\p{N}_\\-]*",
